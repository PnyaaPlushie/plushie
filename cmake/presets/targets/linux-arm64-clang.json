{
    "version": 10,
    "cmakeMinimumRequired": { "major": 3, "minor": 31, "patch": 0 },
    "$comment": [ "Builds for linux arm64 with clang" ],
    "include": [ "../common.json" ],

    "configurePresets":
    [
        {
            "name"            : "linux-arm64-clang",
            "displayName"     : "Linux arm64 (Clang)",
            "inherits"        : [ "base-ninja" ],
            "cacheVariables"  : { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
        }
    ],

    "buildPresets": 
    [
        { "name": "linux-arm64-clang-dbg", "configurePreset": "linux-arm64-clang", "configuration": "Debug"   },        
        { "name": "linux-arm64-clang-rel", "configurePreset": "linux-arm64-clang", "configuration": "Release" }
    ],

    "testPresets":
    [
        {
            "name": "linux-arm64-clang-dbg",
            "configurePreset": "linux-arm64-clang",
            "inherits" : [ "test-base-dbg" ]
        },
        {
            "name": "linux-arm64-clang-rel",
            "configurePreset": "linux-arm64-clang",
            "inherits" : [ "test-base-rel" ]
        }
    ],

    "packagePresets":
    [
        {
            "name": "linux-arm64-clang",
            "configurePreset": "linux-arm64-clang",
            "inherits": ["package-base"]
        }
    ],

    "workflowPresets":
    [
        {
            "name": "linux-arm64-clang-build-package-test", "steps":
            [
                {"type": "configure", "name": "linux-arm64-clang"      },
                {"type": "build",     "name": "linux-arm64-clang-dbg"  },
                {"type": "test",      "name": "linux-arm64-clang-dbg"  },
                {"type": "build",     "name": "linux-arm64-clang-rel"  },
                {"type": "test",      "name": "linux-arm64-clang-rel"  },
                {"type": "package",   "name": "linux-arm64-clang"      }
            ]
        },
        {
            "name": "linux-arm64-clang-build-package", "steps":
            [
                {"type": "configure", "name": "linux-arm64-clang"      },
                {"type": "build",     "name": "linux-arm64-clang-dbg"  },
                {"type": "build",     "name": "linux-arm64-clang-rel"  },
                {"type": "package",   "name": "linux-arm64-clang"      }
            ]
        }
    ]
}